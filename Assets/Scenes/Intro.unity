  m_Script: {fileID: 11500000, guid: 7663132c60e11e149aeb83db0dece3ce, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  videoClips:
  - {fileID: 32900000, guid: cf92d21d520600e4ebbf0a270f48fa1a, type: 3}
  - {fileID: 32900000, guid: 03a996a429250b445bc07f5127b4eea2, type: 3}
  - {fileID: 32900000, guid: f538bf8eea2869f4fbaa99e15517467b, type: 3}
  - {fileID: 32900000, guid: e0db6258a0e54794d915df870f177538, type: 3}
  - {fileID: 32900000, guid: 13f65400dafc2f547ade56187656c37f, type: 3}
  - {fileID: 32900000, guid: f86bb66281c20c24fb2ddd645e9dc1dc, type: 3}
  - {fileID: 32900000, guid: 339ce75f2630f54448f6825b373a6827, type: 3}
  - {fileID: 32900000, guid: d0193b006d1b18447838c4c2686013ab, type: 3}
  - {fileID: 32900000, guid: 2802fb09918675145bba8662a25539b9, type: 3}
  - {fileID: 32900000, guid: 96911c2bf686d194cbb65c7fb416e2df, type: 3}
  - {fileID: 32900000, guid: 8afdeeeba23177842bc94746550b8aec, type: 3}
  - {fileID: 32900000, guid: 00d16461086062c4794b1bd77740400b, type: 3}
  videoPlayer: {fileID: 515552727}
  videoDisplay: {fileID: 515552726}
  subtitles:
  - "\u041A\u043E\u0433\u0434\u0430-\u0442\u043E \u043B\u044E\u0434\u0438 \u0434\u0443\u043C\u0430\u043B\u0438,
    \u0447\u0442\u043E \u0438\u0445 \u043C\u0438\u0440 \u0432\u0435\u0447\u0435\u043D.
    \u0412 \u0442\u043E\u0442 \u0434\u0435\u043D\u044C \u043E\u043D\u0438 \u0434\u0430\u0436\u0435
    \u043D\u0435 \u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0438 \u043D\u0430 \u043D\u0435\u0431\u043E\u2026
    \u0410 \u043E\u043D\u043E \u0443\u0436\u0435 \u0433\u043E\u0442\u043E\u0432\u0438\u043B\u043E\u0441\u044C
    \u0447\u0442\u043E-\u0442\u043E \u0438\u043C \u0441\u043A\u0430\u0437\u0430\u0442\u044C."
  - "\u0412 \u043E\u0434\u043D\u043E\u0447\u0430\u0441\u044C\u0435 \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0439
    \u043E\u0431\u044A\u0435\u043A\u0442 \u043F\u0440\u043E\u0447\u0435\u0440\u0442\u0438\u043B
    \u043D\u0435\u0431\u043E \u0438 \u0441\u043A\u0440\u044B\u043B\u0441\u044F \u0437\u0430
    \u0433\u043E\u0440\u0430\u043C\u0438. \u0413\u0440\u043E\u0445\u043E\u0442 \u043F\u0440\u0438\u0448\u0451\u043B
    \u043F\u043E\u0437\u0436\u0435, \u0430 \u0432\u043C\u0435\u0441\u0442\u0435 \u0441
    \u043D\u0438\u043C - \u0441\u0442\u0440\u0430\u043D\u043D\u0430\u044F \u0442\u0438\u0448\u0438\u043D\u0430."
  - "\u0418\u0437\u043B\u0443\u0447\u0435\u043D\u0438\u0435 \u043C\u0435\u0442\u0435\u043E\u0440\u0438\u0442\u0430
    \u043F\u043E\u0440\u043E\u0434\u0438\u043B\u043E \u0430\u043D\u043E\u043C\u0430\u043B\u0438\u044E,
    \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043D\u0430\u0441\u044B\u0442\u0438\u043B\u0430
    \u043C\u0430\u0433\u0438\u0435\u0439 \u0432\u0441\u0451 \u043D\u0430 \u0437\u0435\u043C\u043B\u0435.
    \u041D\u043E \u044D\u0442\u043E \u0431\u044B\u043B\u043E \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E
    \u0434\u0430\u0440\u043E\u043C, \u043D\u043E \u0438 \u043F\u0440\u043E\u043A\u043B\u044F\u0442\u0438\u0435\u043C."
  - "\u042D\u0442\u043E \u043D\u0430\u0437\u0432\u0430\u043B\u0438 \u042D\u0445\u043E\u043C
    \u0411\u0435\u0437\u043C\u043E\u043B\u0432\u0438\u044F. \u041E\u043D\u043E \u043D\u0435
    \u043F\u0440\u043E\u0441\u0442\u043E \u0438\u0441\u043A\u0430\u0436\u0430\u043B\u043E
    \u043C\u0438\u0440 \u2014 \u043E\u043D\u043E \u0432\u044B\u0441\u0430\u0441\u044B\u0432\u0430\u043B\u043E
    \u0438\u0437 \u043C\u0438\u0440\u0430 \u0432\u0441\u044E \u0436\u0438\u0437\u043D\u044C.
    \u0422\u0438\u0448\u0438\u043D\u0430 \u0438 \u0441\u043C\u0435\u0440\u0442\u044C
    \u0448\u0430\u0433 \u0437\u0430 \u0448\u0430\u0433\u043E\u043C \u0437\u0430\u0445\u0432\u0430\u0442\u044B\u0432\u0430\u043B\u0438
    \u0432\u0441\u0451 \u043D\u043E\u0432\u044B\u0435 \u0437\u0435\u043C\u043B\u0438."
  - "\u0412\u0435\u043B\u0438\u0447\u0430\u0439\u0448\u0438\u0435 \u043C\u0430\u0433\u0438
    \u0441\u043E\u0431\u0440\u0430\u043B\u0438\u0441\u044C \u0432\u043C\u0435\u0441\u0442\u0435,
    \u0447\u0442\u043E\u0431\u044B \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C
    \u0440\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0435\u043D\u0438\u0435.
    \u041E\u043D\u0438 \u0440\u0435\u0448\u0438\u043B\u0438 \u0437\u0430\u043F\u0435\u0440\u0435\u0442\u044C
    \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A \u0443\u0433\u0430\u0441\u0430\u043D\u0438\u044F
    \u0437\u0430 \u043F\u0435\u0447\u0430\u0442\u044F\u043C\u0438, \u0430 \u0432\u043E\u043A\u0440\u0443\u0433
    \u0442\u043E\u0433\u043E \u043C\u0435\u0441\u0442\u0430 \u0432\u043E\u0437\u0432\u0435\u0441\u0442\u0438
    \u043B\u0430\u0431\u0438\u0440\u0438\u043D\u0442, \u0447\u0442\u043E\u0431\u044B
    \u043D\u0438 \u043E\u0434\u043D\u0430 \u0434\u0443\u0448\u0430 \u043D\u0435 \u043F\u043E\u0441\u043C\u0435\u043B\u0430
    \u0438\u0445 \u0440\u0430\u0437\u0440\u0443\u0448\u0438\u0442\u044C."
  - "\u0421 \u0442\u0435\u0445 \u043F\u043E\u0440, \u0432\u043E\u0442 \u0443\u0436\u0435
    7 \u0432\u0435\u043A\u043E\u0432, \u043A\u0430\u0436\u0434\u044B\u0435 \u0441\u0442\u043E
    \u043B\u0435\u0442 \u0433\u043E\u0440\u043E\u0434-\u0445\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u044C
    \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442 \u0433\u0440\u0443\u043F\u043F\u0443
    \u0438\u0437\u0431\u0440\u0430\u043D\u043D\u044B\u0445 \u043C\u0430\u0433\u043E\u0432
    \u0432 \u044D\u043F\u0438\u0446\u0435\u043D\u0442\u0440 \u0430\u043D\u043E\u043C\u0430\u043B\u0438\u0438,
    \u0447\u0442\u043E\u0431\u044B \u0443\u043A\u0440\u0435\u043F\u0438\u0442\u044C
    \u0434\u0440\u0435\u0432\u043D\u0438\u0435 \u043F\u0435\u0447\u0430\u0442\u0438. "
  - 
  - "\u041B\u044E\u0434\u0438 \u0441\u0440\u0430\u0437\u0443 \u043F\u043E\u043D\u044F\u043B\u0438
    \u0447\u0442\u043E \u043F\u0440\u043E\u0438\u0437\u043E\u0448\u043B\u043E. \u041C\u043D\u043E\u0433\u0438\u0435
    \u043D\u0430\u0447\u0430\u043B\u0438 \u0441\u0447\u0438\u0442\u0430\u0442\u044C,
    \u0447\u0442\u043E \u043C\u0438\u0440 \u043E\u0431\u0440\u0435\u0447\u0451\u043D..."
  - "\u041E\u0442\u0447\u0430\u044F\u043D\u0438\u0435 \u0441\u043C\u0435\u043D\u0438\u043B\u043E\u0441\u044C
    \u0440\u0435\u0448\u0438\u043C\u043E\u0441\u0442\u044C\u044E. \u0421 \u043F\u043B\u043E\u0449\u0430\u0434\u0438,
    \u0433\u0434\u0435 \u043F\u0440\u043E\u0432\u043E\u0436\u0430\u043B\u0438 \u043C\u0430\u0433\u043E\u0432,
    \u0442\u0435\u043F\u0435\u0440\u044C \u0437\u0432\u0443\u0447\u0430\u043B \u043F\u0440\u0438\u0437\u044B\u0432
    \u043A \u0434\u043E\u0431\u0440\u043E\u0432\u043E\u043B\u044C\u0446\u0430\u043C.
    \u041D\u0430\u0447\u0430\u043B\u0441\u044F \u043D\u0430\u0431\u043E\u0440 \u0432
    \u043E\u0442\u0440\u044F\u0434, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0434\u043E\u043B\u0436\u0435\u043D
    \u0431\u044B\u043B \u043D\u0430\u0439\u0442\u0438 \u043F\u0440\u043E\u043F\u0430\u0432\u0448\u0438\u0445."
  - "\u042E\u043D\u043E\u0448\u0430 \u0432 \u0442\u043E\u043B\u043F\u0435 \u043D\u0435
    \u043D\u043E\u0441\u0438\u043B \u043C\u0435\u0447\u0430 \u0438 \u043D\u0435 \u0437\u043D\u0430\u043B
    \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u0438\u0439, \u0438 \u0432\u0441\u0451
    \u0436\u0435 \u043C\u0435\u0441\u0442\u043D\u044B\u0439 \u0443\u0447\u0451\u043D\u044B\u0439
    \u2013 \u041B\u043E\u0433\u0430\u043D \u0432 \u0447\u0438\u0441\u043B\u0435 \u043F\u0435\u0440\u0432\u044B\u0445
    \u0437\u0430\u043F\u0438\u0441\u0430\u043B \u0441\u0432\u043E\u0451 \u0438\u043C\u044F
    \u0432 \u0441\u043F\u0438\u0441\u043E\u043A \u0434\u043E\u0431\u0440\u043E\u0432\u043E\u043B\u044C\u0446\u0435\u0432."
  - "\u0415\u0433\u043E \u0432\u0451\u043B \u043B\u0438\u0448\u044C \u043E\u0434\u0438\u043D
    \u043E\u0431\u0435\u0442, \u0434\u0430\u043D\u043D\u044B\u0439 \u0441\u0430\u043C\u043E\u043C\u0443
    \u0441\u0435\u0431\u0435 \u0432 \u043F\u0443\u0441\u0442\u043E\u043C \u0434\u043E\u043C\u0435:
    \u043D\u0430\u0439\u0442\u0438 \u0442\u043E\u0433\u043E, \u043A\u0442\u043E \u043D\u0435
    \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F. \u041E\u043D \u0448\u0451\u043B
    \u043D\u0435 \u043A\u0430\u043A \u0433\u0435\u0440\u043E\u0439 \u2014 \u043E\u043D
    \u0448\u0451\u043B \u043A\u0430\u043A \u0441\u044B\u043D."
  - 
  subtitleText: {fileID: 1581445611}
  subtitlePanel: {fileID: 612654690}
  endButton: {fileID: 1750352196}
